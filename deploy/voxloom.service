[Unit]
Description=VoxLoom FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/voxloom/backend
Environment=APP_ENV=production
Environment=CORS_ORIGINS=https://voxloom.xyz,https://www.voxloom.xyz,https://143-244-135-79.sslip.io
ExecStart=/opt/voxloom/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
