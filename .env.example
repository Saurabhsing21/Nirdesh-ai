# Docker Compose settings. Copy this file to .env in the repository root.
VOXLOOM_PUBLIC_ORIGIN=http://localhost:8080
VOXLOOM_HTTP_PORT=8080

# Required: generate with `openssl rand -hex 32`.
VOXLOOM_JWT_SECRET=replace-with-at-least-32-random-characters

# Required for the voice loop: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional integrations.
EXA_API_KEY=
RESEND_API_KEY=

# Optional knowledge-base RAG add-on. Leave disabled unless OpenAI is configured.
KNOWLEDGE_RAG_ENABLED=false
# When enabled, point to a local file containing only the OpenAI API key.
# The committed empty file keeps the disabled stack bootable without a key.
VOXLOOM_OPENAI_API_KEY_FILE=./deploy/secrets/openai_api_key.empty
